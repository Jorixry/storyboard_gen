# Enhanced first-frame generation (Prompt 7B1/7B2). Server-side ONLY.
# Copy real values into .env.local (git-ignored); never commit real keys.

# Exactly ONE image provider is active at any time (D027). Default: mock.
# mock      deterministic local adapter, no network, no credentials (default)
# seedream  Volcengine Ark Doubao-Seedream (primary) — requires ARK_API_KEY;
#           without the key the route answers 503 provider_credentials_missing
# wanxiang  Alibaba Cloud Model Studio Wan 2.7 (backup) — requires
#           DASHSCOPE_API_KEY; same 503 rule
IMAGE_PROVIDER=mock

# Production-adapter credentials (read only by the matching server-side
# adapter). Put real values ONLY in .env.local:
# ARK_API_KEY=
# DASHSCOPE_API_KEY=

# Optional: workspace-dedicated DashScope domain for wanxiang, e.g.
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com (legacy domain is the
# default when unset):
# DASHSCOPE_BASE_URL=
