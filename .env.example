# Enhanced first-frame generation (Prompt 7B1). Server-side ONLY.
# Copy real values into .env.local (git-ignored); never commit real keys.

# Exactly ONE image provider is active at any time (D027). Default: mock.
# mock      deterministic local adapter, no network, no credentials (default)
# seedream  Volcengine Ark Doubao-Seedream — adapter arrives in Prompt 7B2;
#           until then the route answers 501 provider_adapter_not_implemented
# wanxiang  Alibaba Cloud Model Studio Wan 2.7 — same 7B2 gate as seedream
IMAGE_PROVIDER=mock

# Production-adapter credentials (read only by the matching 7B2 adapter):
# ARK_API_KEY=
# DASHSCOPE_API_KEY=
