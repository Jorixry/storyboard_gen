{
  "name": "storyboard-director-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Storyboard Director MVP - deterministic desktop-Chrome web application scaffold",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run compile:content && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "compile:content": "tsx scripts/compile-content.ts",
    "build": "npm run compile:content && next build"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}
